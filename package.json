{
  "name": "fluencykaizen-video",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Electron, Studio, Remotion, and pipeline workspace for FluencyKaizen video editing.",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:studio\" \"npm:dev:electron\"",
    "dev:studio": "bun src/studio/index.ts",
    "dev:electron": "wait-on tcp:3210 && electron . --dev",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "dev:remotion-editor": "vite --config src/remotion/vite.editor.config.ts",
    "dev:pipeline": "bun src/pipeline/index.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && npm run build:studio && npm run build:remotion",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build:studio": "tsc -p tsconfig.studio.json",
    "build:remotion": "tsc -p tsconfig.remotion.json",
    "start": "electron .",
    "studio": "bun src/studio/index.ts",
    "pipeline": "bun src/pipeline/index.ts",
    "prerender": "bun src/remotion/prepare-render.ts",
    "render": "remotion render src/remotion/index.tsx --public-dir=src/remotion/public --bundle-cache=false",
    "lint": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist .tmp"
  },
  "dependencies": {
    "@google/generative-ai": "^0.19.0",
    "@remotion/player": "4.0.434",
    "@remotion/studio-server": "4.0.434",
    "@remotion/studio-shared": "4.0.434",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.434",
    "@remotion/studio": "4.0.434",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "bun-types": "latest",
    "concurrently": "^9.1.2",
    "electron": "^33.0.0",
    "remotion": "4.0.434",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.0.0",
    "vite": "^7.1.3",
    "wait-on": "^8.0.1"
  }
}
